# ============================================================
#  Bruce Burguer — API (server/.env)
#  Copie este arquivo para "server/.env" e preencha os valores.
#  Em produção prefira variáveis do provedor (Painel/Railway/Fly)
#  ou um arquivo "server/.env.production" (nunca commitado).
#  NUNCA versione .env, .env.production ou qualquer arquivo
#  que contenha segredos reais.
# ============================================================

# Ambiente: development | production
NODE_ENV=development

# Porta e host da API (host 0.0.0.0 = acessível na rede)
PORT=3001
HOST=0.0.0.0

# ------------------------------------------------------------
# JWT_SECRET — OBRIGATÓRIO (mínimo 32 caracteres).
# Assina os tokens de login. Se trocar, desloga todos os usuários.
# Gere um valor forte com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ------------------------------------------------------------
JWT_SECRET=troque-por-uma-string-longa-aleatoria-com-pelo-menos-32-caracteres

# Banco SQLite. Vazio = server/data/bruce-burguer.db (banco DEMO de desenvolvimento).
# Em produção aponte para um arquivo dedicado (fora do repositório):
# DB_PATH=C:/dados/bruce-burguer-producao.db   (Windows)
# DB_PATH=/var/lib/bruce-burguer/bruce-burguer.db    (Linux)
DB_PATH=

# Modo de inicialização do banco:
#   demo   → (desenvolvimento) cria dados de demonstração na 1ª execução, se não houver usuários
#   schema → (produção) apenas tabelas; usuário admin é criado com `npm run db:init`
# Obs: em NODE_ENV=production o seed de demonstração é SEMPRE bloqueado.
DB_INIT=demo

# CORS: vazio = liberado (somente desenvolvimento).
# Em produção defina o(s) domínio(s), separados por vírgula:
# CORS_ORIGIN=https://loja.seudominio.com,https://www.seudominio.com
CORS_ORIGIN=

# URL pública do sistema (links absolutos externos — ex.: compartilhamento de pedido)
# PUBLIC_URL=https://loja.seudominio.com
PUBLIC_URL=

# Empresa exibida no catálogo público. Obrigatório em produção.
# Não é recebido do frontend; é configuração do servidor.
PUBLIC_COMPANY_ID=

# Identificador confirmado pelo responsável para dados legados single-tenant.
# Não preencher sem confirmação operacional. Ausente = migration legada bloqueada.
LEGACY_COMPANY_ID=

# ------------------------------------------------------------
# Criação do admin do banco de produção (npm run db:init):
#   ADMIN_EMAIL=admin@minhaloja.com
#   ADMIN_PASSWORD=senha-forte-aqui
# Usadas apenas pelo script de inicialização; nunca no runtime normal.
# ------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ------------------------------------------------------------
# PRÓXIMOS PASSOS (ainda NÃO utilizados nesta versão — somente preparação
# de arquitetura para PostgreSQL/Supabase e storage de imagens):
#   DATABASE_URL=postgresql://...
#   SUPABASE_URL=https://xxxx.supabase.co
#   SUPABASE_SERVICE_ROLE_KEY=
#   STORAGE_BUCKET=
# As imagens dos produtos já são URLs externas; o logo da loja também.
# ------------------------------------------------------------
