{
  "name": "nyellen-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "start:prod": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:billing": "tsx scripts/test-billing.ts",
    "test:migration": "tsx scripts/test-migration.ts",
    "test:users": "tsx scripts/test-users.ts",
    "test:receipt": "tsx scripts/test-receipt.ts",
    "test:image": "tsx scripts/test-image.ts",
    "test:labels": "tsx scripts/test-labels.ts",
    "test:homolog": "tsx scripts/test-homolog.ts",
    "test:receivables": "tsx scripts/test-receivables.ts",
    "test:delivery": "tsx scripts/test-delivery.ts",
    "test:barcodes": "tsx scripts/test-barcodes.ts",
    "db:init": "tsx scripts/init-db.ts",
    "db:init:demo": "tsx scripts/init-db.ts --demo"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.0"
  },
  "allowScripts": {}
}
