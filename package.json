{
  "name": "bruce-burguer",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": "22.x"
  },
  "description": "Sistema de gestão da loja Bruce Burguer",
  "scripts": {
    "postinstall": "npm --prefix server install && npm --prefix web install",
    "setup": "npm --prefix server install && npm --prefix web install",
    "dev:api": "npm --prefix server run dev",
    "dev:web": "npm --prefix web run dev",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "build": "npm --prefix web run build && npm --prefix server run build",
    "build:web": "npm --prefix web run build",
    "build:api": "npm --prefix server run build",
    "test:billing": "npm --prefix server run test:billing",
    "start": "npm run start:api:prod",
    "start:api": "npm --prefix server run start",
    "start:api:prod": "npm --prefix server run start:prod",
    "db:init": "npm --prefix server run db:init",
    "db:init:demo": "npm --prefix server run db:init:demo"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "vitest": "^5.0.0"
  }
}
